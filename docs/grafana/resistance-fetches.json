{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "PartyKing: Resistance fetches",
  "uid": "partyking-resistance-fetches",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "partyking"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "How many fetches a Resistance action causes: GET game and GET lobby per write, and how many game reads share a query. Requests that fail authorization before the action runs are not counted.",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "GET game and GET lobby against the writes that caused the pushes. Every successful write sends one ResistanceChanged to the whole session group.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"Get\",http_request_method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "GET game"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"GetLobby\",http_request_method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "GET lobby"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",http_request_method!=\"GET\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "writes (successful)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GETs per successful write (fan-out)",
      "description": "Resistance GETs (game + lobby) divided by successful writes over the window: how many fetches one action costs on average. Roughly connections x GET hooks per connection when every push is answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"Get\",http_request_method=\"GET\"}[$__rate_interval])) / sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",http_request_method!=\"GET\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "game"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"GetLobby\",http_request_method=\"GET\"}[$__rate_interval])) / sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",http_request_method!=\"GET\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "lobby"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"Get\",http_request_method=\"GET\"}[$__rate_interval])) + sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=\"GetLobby\",http_request_method=\"GET\"}[$__rate_interval]))) / sum(increase(partyking_controller_action_duration_milliseconds_count{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",http_request_method!=\"GET\",outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Game reads: own query vs shared",
      "description": "Reads of the Resistance game inside the repository (partyking.games.reads). shared=true joined a query already in flight, shared=false ran its own 4-query load. Writes also read the game, so these exceed the GET rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (shared) (rate(partyking_games_reads_total{repository=\"ResistanceGamesRepository\"}[$__rate_interval]))",
          "legendFormat": "shared={{shared}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Share of reads that joined a query in flight",
      "description": "Fraction of game reads that did not hit the database. Low values mean the clients' random delay spreads the fetches too thin for the sharing to help.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(partyking_games_reads_total{repository=\"ResistanceGamesRepository\"}{shared=\"true\"}[$__rate_interval])) / sum(rate(partyking_games_reads_total{repository=\"ResistanceGamesRepository\"}[$__rate_interval]))",
          "legendFormat": "shared"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GET duration p95",
      "description": "Time of the controller action only (filters such as session access run before it and are not included).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, action) (rate(partyking_controller_action_duration_milliseconds_bucket{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",action=~\"Get|GetLobby\",http_request_method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Write duration p95",
      "description": "Time of a successful write action: session lookups, the game load, the lock, the save and the pushes, which run before the response returns.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, action) (rate(partyking_controller_action_duration_milliseconds_bucket{controller=~\"Resistance|ResistanceRound|ResistancePlotCards\",http_request_method!=\"GET\",outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "{{action}}"
        }
      ]
    }
  ]
}
