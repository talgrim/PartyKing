{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "PartyKing: identity service",
  "uid": "partyking-identity",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "partyking"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "How PartyKing's calls to the identity service (auth.talgrim.dev, GET /api/session) go: outcomes, latency, the cache in front of them and the stale answers served during an outage (talgrim.identity.client.*). A request without the session cookie never calls the service, so guests do not show up here.",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Calls by outcome",
      "description": "Calls to the identity service per second (cache misses only), by what it answered: account, anonymous (401), forbidden (403) or unavailable (timeout, 5xx, unreadable answer).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(talgrim_identity_client_calls_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Unavailable share",
      "description": "Share of the calls that got no usable answer. A logged-in feature (admin, saved playlists) then answers 503 unless a stale answer is served. Alert idea: above 5% for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(talgrim_identity_client_calls_total{outcome=\"unavailable\"}[$__rate_interval])) / sum(rate(talgrim_identity_client_calls_total[$__rate_interval]))",
          "legendFormat": "unavailable"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Call duration p95 by outcome",
      "description": "95th percentile of the time the identity service took to answer. The client times out after Identity:TimeoutSeconds, so unavailable sits at that value for a timeout. Alert idea: p95 of account above 500 ms for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(talgrim_identity_client_call_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "Requests answered from the cache (talgrim.identity.client.cache.hits) against all lookups (hits plus calls). Low means many distinct sessions or a cache that is too small (10,000 entries).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(talgrim_identity_client_cache_hits_total[$__rate_interval])) / (sum(rate(talgrim_identity_client_cache_hits_total[$__rate_interval])) + sum(rate(talgrim_identity_client_calls_total[$__rate_interval])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Stale answers",
      "description": "Answers served from an expired cache entry because the identity service was unreachable (talgrim.identity.client.stale): people stay logged in during an outage, for at most Identity:StaleSeconds. Any rate above 0 means an outage is going on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(talgrim_identity_client_stale_total[$__rate_interval]))",
          "legendFormat": "stale"
        }
      ]
    }
  ]
}
