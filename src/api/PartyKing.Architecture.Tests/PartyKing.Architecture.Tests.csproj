<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tests are not code to cover: coverlet, dotCover and Visual Studio all skip an assembly with this attribute -->
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Referenced so that every assembly is copied next to the tests and can be loaded by name -->
        <ProjectReference Include="..\PartyKing.API\PartyKing.API.csproj" />
        <ProjectReference Include="..\PartyKing.Application\PartyKing.Application.csproj" />
        <ProjectReference Include="..\PartyKing.Contract\PartyKing.Contract.csproj" />
        <ProjectReference Include="..\PartyKing.Domain\PartyKing.Domain.csproj" />
        <ProjectReference Include="..\PartyKing.Infrastructure\PartyKing.Infrastructure.csproj" />
        <ProjectReference Include="..\PartyKing.Infrastructure.Llm\PartyKing.Infrastructure.Llm.csproj" />
        <ProjectReference Include="..\PartyKing.Infrastructure.Lyrics\PartyKing.Infrastructure.Lyrics.csproj" />
        <ProjectReference Include="..\PartyKing.Infrastructure.Spotify\PartyKing.Infrastructure.Spotify.csproj" />
        <ProjectReference Include="..\PartyKing.Infrastructure.Youtube\PartyKing.Infrastructure.Youtube.csproj" />
        <ProjectReference Include="..\PartyKing.Persistence\PartyKing.Persistence.csproj" />
    </ItemGroup>

</Project>
