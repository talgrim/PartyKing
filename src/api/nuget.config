<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The identity client packages (Talgrim.Identity.*) are published to GitHub Packages, which needs a classic token with
    read:packages even for a package that is only read. The credentials are deliberately not here: a credential in this
    file would override the one a developer has in their own NuGet config. See docs/deployment.md (NuGet packages).
  -->
  <packageSources>
    <add key="github-talgrim" value="https://nuget.pkg.github.com/talgrim/index.json" />
  </packageSources>

  <!-- Only the identity packages come from GitHub: nobody can put a package of that name on nuget.org and have it picked up -->
  <packageSourceMapping>
    <packageSource key="github-talgrim">
      <package pattern="Talgrim.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
